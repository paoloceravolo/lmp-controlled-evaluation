<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>choice b d e</text></name>
    <page id="page1">
      <place id="p_start">
        <name><text>p_start</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
      <place id="p_choice">
        <name><text>p_choice</text></name>
      </place>
      <place id="p_after_choice">
        <name><text>p_after_choice</text></name>
      </place>
      <place id="p_end">
        <name><text>p_end</text></name>
      </place>
      <transition id="t_prefix_1">
        <name><text>a</text></name>
      </transition>
      <transition id="t_b">
        <name><text>b</text></name>
      </transition>
      <transition id="t_d">
        <name><text>d</text></name>
      </transition>
      <transition id="t_e">
        <name><text>e</text></name>
      </transition>
      <transition id="t_suffix_1_c">
        <name><text>c</text></name>
      </transition>
      <arc id="arc_1" source="p_start" target="t_prefix_1"/>
      <arc id="arc_2" source="t_prefix_1" target="p_choice"/>
      <arc id="arc_3" source="p_choice" target="t_b"/>
      <arc id="arc_4" source="t_b" target="p_after_choice"/>
      <arc id="arc_5" source="p_choice" target="t_d"/>
      <arc id="arc_6" source="t_d" target="p_after_choice"/>
      <arc id="arc_7" source="p_choice" target="t_e"/>
      <arc id="arc_8" source="t_e" target="p_after_choice"/>
      <arc id="arc_9" source="p_after_choice" target="t_suffix_1_c"/>
      <arc id="arc_10" source="t_suffix_1_c" target="p_end"/>
    </page>
    <finalmarkings>
