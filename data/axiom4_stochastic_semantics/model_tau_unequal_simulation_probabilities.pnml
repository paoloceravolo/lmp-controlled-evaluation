      <arc id="arc_10" source="tau_review" target="p_review_before_review"/>
      <arc id="arc_11" source="p_main_choice" target="tau_main_notify"/>
      <arc id="arc_12" source="tau_main_notify" target="p_main_notify_before_approve"/>
      <arc id="arc_13" source="p_main_choice" target="tau_main_skip_notify"/>
      <arc id="arc_14" source="tau_main_skip_notify" target="p_main_skip_before_approve"/>
