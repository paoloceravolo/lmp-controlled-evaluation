      </place>
      <place id="p_review_before_approve">
        <name><text>p_review_before_approve</text></name>
      </place>
      <place id="p_review_after_approve">
        <name><text>p_review_after_approve</text></name>
      </place>
      <place id="p_end">
        <name><text>p_end</text></name>
      </place>
      <transition id="t_start">
        <name><text>start</text></name>
      </transition>
      <transition id="t_assess">
        <name><text>assess</text></name>
      </transition>
      <transition id="tau_main">
        <name><text>tau_main</text></name>
        <toolspecific tool="ProM" version="6.0" activity="invisible"/>
      </transition>
      <transition id="tau_request">
        <name><text>tau_request</text></name>
        <toolspecific tool="ProM" version="6.0" activity="invisible"/>
      </transition>
      <transition id="tau_review">
        <name><text>tau_review</text></name>
        <toolspecific tool="ProM" version="6.0" activity="invisible"/>
      </transition>
      <transition id="tau_main_notify">
        <name><text>tau_main_notify</text></name>
        <toolspecific tool="ProM" version="6.0" activity="invisible"/>
      </transition>
      <transition id="tau_main_skip_notify">
        <name><text>tau_main_skip_notify</text></name>
        <toolspecific tool="ProM" version="6.0" activity="invisible"/>
      </transition>
      <transition id="t_main_notify_approve">
        <name><text>approve</text></name>
      </transition>
      <transition id="t_main_notify">
        <name><text>notify</text></name>
      </transition>
      <transition id="t_main_notify_close">
        <name><text>close</text></name>
      </transition>
      <transition id="t_main_skip_approve">
        <name><text>approve</text></name>
