      <arc id="arc_18" source="t_main_notify" target="p_main_notify_after_notify"/>
      <arc id="arc_19" source="p_main_notify_after_notify" target="t_main_notify_close"/>
      <arc id="arc_20" source="t_main_notify_close" target="p_end"/>
      <arc id="arc_21" source="p_main_skip_before_approve" target="t_main_skip_approve"/>
      <arc id="arc_22" source="t_main_skip_approve" target="p_main_skip_after_approve"/>
      <arc id="arc_23" source="p_main_skip_after_approve" target="t_main_skip_close"/>
      <arc id="arc_24" source="t_main_skip_close" target="p_end"/>
      <arc id="arc_25" source="p_request_before_info" target="t_request_info"/>
      <arc id="arc_26" source="t_request_info" target="p_request_before_approve"/>
      <arc id="arc_27" source="p_request_before_approve" target="t_request_approve"/>
      <arc id="arc_28" source="t_request_approve" target="p_request_after_approve"/>
      <arc id="arc_29" source="p_request_after_approve" target="t_request_notify"/>
      <arc id="arc_30" source="t_request_notify" target="p_request_after_notify"/>
      <arc id="arc_31" source="p_request_after_notify" target="t_request_close"/>
      <arc id="arc_32" source="t_request_close" target="p_end"/>
      <arc id="arc_33" source="p_review_before_review" target="t_review"/>
      <arc id="arc_34" source="t_review" target="p_review_before_approve"/>
      <arc id="arc_35" source="p_review_before_approve" target="t_review_approve"/>
      <arc id="arc_36" source="t_review_approve" target="p_review_after_approve"/>
      <arc id="arc_37" source="p_review_after_approve" target="t_review_close"/>
      <arc id="arc_38" source="t_review_close" target="p_end"/>
    </page>
    <finalmarkings>
      <marking>
        <place idref="p_end"><text>1</text></place>
      </marking>
