      <transition id="t_request_notify">
        <name><text>notify</text></name>
      </transition>
      <transition id="t_request_close">
        <name><text>close</text></name>
      </transition>
      <transition id="t_review">
        <name><text>manual_review</text></name>
      </transition>
      <transition id="t_review_approve">
        <name><text>approve</text></name>
      </transition>
      <transition id="t_review_close">
        <name><text>close</text></name>
      </transition>
      <arc id="arc_1" source="p_start" target="t_start"/>
      <arc id="arc_2" source="t_start" target="p_after_start"/>
