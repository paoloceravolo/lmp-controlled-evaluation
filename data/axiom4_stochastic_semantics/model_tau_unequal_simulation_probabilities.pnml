<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>M_tau - same visible language, unequal simulation probabilities</text></name>
    <page id="page1">
      <place id="p_start">
        <name><text>p_start</text></name>
        <initialMarking><text>1</text></initialMarking>
      </place>
